# Example environment for figma-mcp-free
# Do not commit real credentials. Prefer process-local environment variables.

# Figma REST backend
FIGMA_TOKEN=
FIGMA_MCP_CACHE_TTL_MS=300000
FIGMA_MCP_MAX_CACHE_ENTRIES=128
FIGMA_MCP_REQUEST_TIMEOUT_MS=20000
FIGMA_MCP_MAX_RETRIES=2
FIGMA_MCP_NODE_BATCH_SIZE=100

# Optional local Figma development-Plugin bridge
# Start `pnpm --filter figma-mcp-free bridge -- serve` first.
# Copy the printed loopback origin and ephemeral pairing token into the
# MCP/CLI process environment. Never commit the real token.
FIGMA_PLUGIN_BRIDGE_URL=http://127.0.0.1:3845
FIGMA_PLUGIN_BRIDGE_TOKEN=
FIGMA_PLUGIN_BRIDGE_TIMEOUT_MS=10000
